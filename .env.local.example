# Entorno de desarrollo local: se carga antes que .env al ejecutar Vite.
# Genera .env.local con `pnpm db:local:env` despues de levantar Supabase.
VITE_SUPABASE_URL=http://127.0.0.1:57321
VITE_SUPABASE_ANON_KEY=pega-aqui-la-publishable-key-local

# Solo para scripts de backup/restore locales; nunca uses una URL remota aqui.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:57322/postgres
